# MongoDB connection string. Locally: mongodb://localhost:27017/portfolio
# In production (Heroku), use a MongoDB Atlas connection string set via `heroku config:set`.
MONGODB_URI=mongodb://localhost:27017/portfolio

# Comma-separated list of origins allowed to call this API (your Vercel deployment + any custom domain).
# Leave unset to allow all origins (fine for local dev, not recommended in production).
CORS_ORIGIN=http://localhost:3000,https://your-portfolio.vercel.app

# Heroku sets PORT automatically; only needed for local dev.
PORT=4000

# Optional. Free API token from ipinfo.io, used for more accurate city/region
# lookups on page visits. Falls back to the offline geoip-lite database when
# unset or when the ipinfo.io call fails/times out.
IPINFO_TOKEN=

# Optional secret for the visitors dashboard (/api/admin/*).
# Leave empty to keep the visitor data public; set it to require a token. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_TOKEN=

