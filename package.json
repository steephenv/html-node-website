{
  "name": "portfolio-feedback-api",
  "private": true,
  "version": "1.0.0",
  "description": "Backend API for the portfolio contact form. Saves name/email/message submissions to MongoDB.",
  "main": "dist/server.js",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "heroku-postbuild": "npm run build",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "geoip-lite": "^1.4.10",
    "helmet": "^7.1.0",
    "mongoose": "^8.6.0",
    "ua-parser-js": "^2.0.10",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/geoip-lite": "^1.4.4",
    "@types/node": "^20.14.15",
    "@types/ua-parser-js": "^0.7.39",
    "tsx": "^4.19.0",
    "typescript": "^5.5.4"
  }
}
